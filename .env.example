# Frontend (Nuxt). Usa NUXT_PORT para no chocar con el puerto del backend.
NUXT_PORT=9000

# Backend API (API_PORT solo aplica a localhost; en prod no se concatena)
API_URL=http://127.0.0.1
API_PORT=8000

# Opcional: URL completa del backend (tiene prioridad sobre API_URL + API_PORT)
# Local:  NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Prod:   NUXT_PUBLIC_API_BASE_URL=https://nexxus-server.up.railway.app

# Endpoint de autenticación (relativo a apiBaseUrl)
# NUXT_PUBLIC_API_AUTH_PATH=/api/auth/login/
# NUXT_PUBLIC_API_AUTH_LOGOUT_PATH=/auth/logout/

# Webhook de n8n para subir archivos a Firebase Storage (el front sube directo, no pasa por Django)
# NUXT_PUBLIC_N8N_UPLOAD_URL=https://n8n.srv1137762.hstgr.cloud/webhook/upload-firebase-general
